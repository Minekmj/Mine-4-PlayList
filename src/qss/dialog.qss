QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(244, 248, 252, 0.85), 
        stop:1 rgba(226, 237, 248, 0.78));
}

#dialogContainer {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(244, 248, 252, 0.85), 
        stop:1 rgba(226, 237, 248, 0.78));
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 14px;
}

#dialogHeader {
    background: transparent;
    padding: 6px 8px 8px 8px;
}

#dialogTitle {
    font-size: 13px;
    font-weight: 700;
    color: #1F2D3D;
}

#dialogCloseBtn {
    background: rgba(220, 80, 80, 0.3);
    color: #617588;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    width: 24px;
    height: 24px;
}
#dialogCloseBtn:hover {
    background: rgba(220, 80, 80, 0.5);
    color: #D32F2F;
}
#dialogCloseBtn:pressed {
    background: rgba(220, 80, 80, 0.6);
}

#cardFrame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(255, 255, 255, 0.65), 
        stop:1 rgba(240, 247, 253, 0.45));
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 10px;
}

#presetGridCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(255, 255, 255, 0.85), 
        stop:1 rgba(238, 245, 253, 0.70));
    border: 1.5px solid rgba(180, 205, 226, 0.70);
    border-radius: 14px;
}
#presetGridCard:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(255, 255, 255, 0.98), 
        stop:1 rgba(240, 248, 255, 0.92));
    border-color: #528DC2;
}

#presetGridCardActive {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(230, 243, 255, 0.95), 
        stop:1 rgba(212, 234, 254, 0.90));
    border: 2px solid #528DC2;
    border-radius: 14px;
}

#presetCardTitle {
    font-size: 14px;
    font-weight: 700;
    color: #1F2D3D;
    background: transparent;
    border: none;
}

#presetCardDecoLine {
    background: rgba(180, 205, 226, 0.45);
    border: none;
}

#presetCardCount {
    font-size: 11px;
    color: #64748B;
    background: transparent;
    border: none;
}

#presetCardBadge {
    font-size: 10px;
    font-weight: 700;
    color: #2F6F9F;
    background: rgba(82, 141, 194, 0.22);
    border: none;
    border-radius: 4px;
    padding: 2px 6px;
}

#presetCardActionBtn {
    background: rgba(220, 226, 235, 0.6);
    color: #4A5568;
    border: 1px solid rgba(180, 200, 220, 0.5);
    border-radius: 11px;
    font-size: 10px;
    padding: 0px;
}
#presetCardActionBtn:hover {
    background: #528DC2;
    color: #FFFFFF;
    border-color: #4176A3;
}

#presetCardDeleteBtn {
    background: rgba(220, 226, 235, 0.6);
    color: #64748B;
    border: 1px solid rgba(180, 200, 220, 0.5);
    border-radius: 11px;
    font-size: 11px;
    font-weight: 700;
    padding: 0px;
}
#presetCardDeleteBtn:hover {
    background: #EF4444;
    color: #FFFFFF;
    border-color: #DC2626;
}
#presetCardDeleteBtn:pressed {
    background: #DC2626;
    color: #FFFFFF;
}

#presetAddCard {
    background: rgba(255, 255, 255, 0.40);
    border: 2px dashed rgba(160, 190, 218, 0.75);
    border-radius: 14px;
}
#presetAddCard:hover {
    background: rgba(240, 248, 255, 0.85);
    border-color: #528DC2;
}
#presetAddCardIcon {
    font-size: 40px;
    font-weight: 300;
    color: #528DC2;
    background: transparent;
    border: none;
    margin-bottom: -4px;
}
#presetAddCardText {
    font-size: 12px;
    font-weight: 700;
    color: #528DC2;
    background: transparent;
    border: none;
}

QMenu {
    background-color: rgba(250, 253, 255, 0.96);
    border: 1px solid rgba(180, 205, 226, 0.85);
    border-radius: 8px;
    padding: 4px;
    color: #1F2D3D;
}
QMenu::item {
    padding: 6px 14px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: rgba(82, 141, 194, 0.2);
    color: #1F2D3D;
}

QTabWidget::pane {
    border: none;
    background: transparent;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #556B82;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    margin-right: 4px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover {
    color: #1F2D3D;
    background: rgba(255, 255, 255, 0.4);
    border-radius: 6px 6px 0 0;
}
QTabBar::tab:selected {
    color: #2F6F9F;
    font-weight: 700;
    border-bottom: 2px solid #528DC2;
}

QLabel {
    background: transparent;
    color: #374758;
    font-size: 12px;
    font-weight: 500;
}

QLabel#pub {
    color: rgb(104, 104, 104);
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QFontComboBox {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(180, 205, 226, 0.6);
    border-radius: 6px;
    padding: 5px 8px;
    color: #1F2D3D;
    font-size: 12px;
    selection-background-color: rgba(107, 160, 207, 0.35);
    selection-color: #102030;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    background: rgba(255, 255, 255, 0.85);
    border-color: rgba(142, 185, 216, 0.85);
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid #5A95C6;
}

QSpinBox, QDoubleSpinBox {
    padding-right: 20px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    height: 11px;
    border-left: 1px solid rgba(180, 205, 226, 0.5);
    border-bottom: 1px solid rgba(180, 205, 226, 0.3);
    border-top-right-radius: 5px;
    background: rgba(240, 246, 252, 0.6);
    margin: 1px 1px 0 0;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    height: 11px;
    border-left: 1px solid rgba(180, 205, 226, 0.5);
    border-bottom-right-radius: 5px;
    background: rgba(240, 246, 252, 0.6);
    margin: 0 1px 1px 0;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(255, 255, 255, 0.9);
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 6px;
    height: 4px;
}

QComboBox::drop-down, QFontComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView, QFontComboBox QAbstractItemView {
    background-color: rgba(250, 253, 255, 0.94);
    border: 1px solid rgba(180, 205, 226, 0.8);
    border-radius: 6px;
    color: #1F2D3D;
    selection-background-color: rgba(107, 160, 207, 0.25);
    selection-color: #102030;
    padding: 4px;
    outline: none;
}

QCheckBox {
    color: #374758;
    font-size: 12px;
    spacing: 7px;
    background: transparent;
}
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid rgba(180, 205, 226, 0.8);
    background: rgba(255, 255, 255, 0.65);
}
QCheckBox::indicator:hover {
    background: rgba(255, 255, 255, 0.9);
    border-color: #7AAED8;
}
QCheckBox::indicator:checked {
    background: #528DC2;
    border-color: #437AA8;
}

QSlider {
    height: 20px;
}
QSlider::groove:horizontal {
    height: 4px;
    background: rgba(180, 205, 226, 0.45);
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 rgba(139, 188, 224, 0.85), 
        stop:1 rgba(90, 150, 200, 0.9));
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1.5px solid #528DC2;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #F0F7FD;
    border-color: #3572A5;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(255, 255, 255, 0.75), 
        stop:1 rgba(235, 244, 252, 0.6));
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-bottom: 1px solid rgba(180, 205, 226, 0.7);
    border-radius: 6px;
    padding: 6px 14px;
    color: #2D3E4F;
    font-size: 12px;
    font-weight: 600;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(255, 255, 255, 0.95), 
        stop:1 rgba(242, 248, 254, 0.85));
    border-color: rgba(160, 195, 225, 0.85);
    color: #172431;
}
QPushButton:pressed {
    background: rgba(220, 235, 247, 0.7);
    border-color: rgba(140, 180, 215, 0.85);
}

#accentBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(115, 170, 214, 0.88), 
        stop:1 rgba(85, 145, 192, 0.88));
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 6px;
    color: #FFFFFF;
    font-weight: 600;
}
#accentBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(125, 180, 224, 0.95), 
        stop:1 rgba(95, 155, 202, 0.95));
    border-color: rgba(255, 255, 255, 0.5);
}
#accentBtn:pressed {
    background: rgba(75, 130, 175, 0.95);
}

QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgba(148, 163, 184, 0.4);
    min-height: 24px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(100, 116, 139, 0.7);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}