#dialogContainer {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #F4F8FC, 
        stop:1 #E6EFF8);
    border: 1px solid #D0DFED;
    border-radius: 14px;
}

#dialogHeader {
    background: transparent;
    padding: 6px 8px 8px 8px;
}

#dialogTitle {
    font-size: 13px;
    font-weight: 600;
    color: #334455;
}

#dialogCloseBtn {
    background: transparent;
    color: #7A8E9E;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    width: 24px;
    height: 24px;
}
#dialogCloseBtn:hover {
    background: rgba(220, 100, 100, 0.12);
    color: #C25454;
}
#dialogCloseBtn:pressed {
    background: rgba(220, 100, 100, 0.22);
}

#cardFrame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #FAFDFE, 
        stop:1 #F2F7FC);
    border: 1px solid #D7E4EE;
    border-radius: 10px;
}

QTabWidget::pane {
    border: none;
    background: transparent;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #6C8094;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 12px;
    margin-right: 4px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover {
    color: #334455;
    background: rgba(140, 185, 225, 0.12);
    border-radius: 6px 6px 0 0;
}
QTabBar::tab:selected {
    color: #4A83B4;
    font-weight: 600;
    border-bottom: 2px solid #6BA0CF;
}

QLabel {
    background: transparent;
    color: #556779;
    font-size: 12px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QFontComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #FBFCFE, 
        stop:1 #F5F9FD);
    border: 1px solid #CBDCEB;
    border-radius: 6px;
    padding: 5px 8px;
    color: #334455;
    font-size: 12px;
    selection-background-color: #D3E5F5;
    selection-color: #243545;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #AECADB;
    background: #F8FBFE;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #71A4CC;
    background: #FFFFFF;
}

QSpinBox, QDoubleSpinBox {
    padding-right: 20px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    height: 11px;
    border-left: 1px solid #CBDCEB;
    border-bottom: 1px solid #E0ECF5;
    border-top-right-radius: 5px;
    background: #F1F6FB;
    margin: 1px 1px 0 0;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    height: 11px;
    border-left: 1px solid #CBDCEB;
    border-bottom-right-radius: 5px;
    background: #F1F6FB;
    margin: 0 1px 1px 0;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #E2EEF8;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background: #D4E3EF;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 6px;
    height: 4px;
}

QComboBox::drop-down, QFontComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView, QFontComboBox QAbstractItemView {
    background-color: #FAFDFE;
    border: 1px solid #CBDCEB;
    border-radius: 6px;
    color: #334455;
    selection-background-color: #E4EFF8;
    selection-color: #243545;
    padding: 4px;
    outline: none;
}

QCheckBox {
    color: #475869;
    font-size: 12px;
    spacing: 7px;
    background: transparent;
}
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid #CBDCEB;
    background: #FAFDFE;
}
QCheckBox::indicator:hover {
    border-color: #8EB9D8;
    background: #F2F7FC;
}
QCheckBox::indicator:checked {
    background: #6BA0CF;
    border-color: #5C91BD;
}

QSlider {
    height: 20px;
}
QSlider::groove:horizontal {
    height: 4px;
    background: #DCE7F0;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #8BBCE0, 
        stop:1 #6BA0CF);
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #FAFDFE;
    border: 1.5px solid #6BA0CF;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    border-color: #4A83B4;
    background: #FFFFFF;
}
QSlider::handle:horizontal:pressed {
    background: #E8F2FA;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #FAFBFD, 
        stop:1 #EDF3F8);
    border: 1px solid #CBDCEB;
    border-radius: 6px;
    padding: 6px 14px;
    color: #405263;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #FFFFFF, 
        stop:1 #F2F7FC);
    border-color: #ABC5DB;
    color: #243545;
}
QPushButton:pressed {
    background: #E4ECF4;
    border-color: #ABC5DB;
}

#accentBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #7BAFD6, 
        stop:1 #659BC6);
    border: 1px solid #558EB7;
    border-radius: 6px;
    color: #FFFFFF;
    font-weight: 500;
}
#accentBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #86B8DC, 
        stop:1 #6EA2CC);
    border-color: #5F95BE;
}
#accentBtn:pressed {
    background: #558CB4;
    border-color: #487B9F;
}

QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px 0px;
}
QScrollBar::handle:vertical {
    background: #CADAE8;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #A6C2DB;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}