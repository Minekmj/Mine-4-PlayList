QMainWindow {
    background-color: #151A24;
}

QWidget {
    color: #E2EAF4;
    font-family: 'Pretendard', 'Segoe UI', -apple-system, sans-serif;
    font-size: 12px;
    selection-background-color: rgba(180, 205, 235, 0.25);
    selection-color: #FFFFFF;
}

QLabel {
    background: transparent;
    color: #CBD7E6;
}

#lbl_cur_time {
    color: #E9EFF5;
    font-size: 11px;
}

#lbl_total_time {
    color: #EAF0F7;
    font-size: 11px;
}

#lbl_list {
    font-weight: 700;
    font-size: 14px;
    color: #E6F0FA;
}

#lbl_list_count {
    color: #AFC8E8;
    font-size: 12px;
}

QToolTip {
    background-color: rgba(135, 150, 179, 0.99);
    color: #EDF4FC;
    padding: 5px 9px;
    font-size: 11px;
}

/* 기본 버튼: 은은한 테두리 추가 및 밝기/밀도 상향 */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(230, 240, 255, 0.14), 
        stop:1 rgba(205, 222, 248, 0.20));
    border: 1px solid rgba(225, 238, 255, 0.18);
    border-radius: 8px;
    padding: 6px 14px;
    color: #DBE6F5;
    font-weight: 500;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(240, 248, 255, 0.24), 
        stop:1 rgba(215, 230, 255, 0.32));
    border: 1px solid rgba(230, 242, 255, 0.45);
    color: #FFFFFF;
}

QPushButton:pressed {
    background: rgba(180, 200, 225, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.20);
    color: #C8D6E8;
}

QPushButton:disabled {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.25);
}

QPushButton#btn_mode {
    font-size: 11px;
    padding: 4px 9px;
}

QPushButton#iconBtn {
    background: transparent;
    border: none;
    padding: 5px;
    border-radius: 6px;
}

QPushButton#iconBtn:hover {
    background: rgba(210, 225, 245, 0.18);
}

QPushButton#playBtn {
    background: transparent;
    border: none;
    border-radius: 20px;
}

QSlider {
    height: 20px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: rgba(255, 255, 255, 0.16);
    border-radius: 2px;
}

/* 슬라이더 진행 바: 밝기와 채도 약간 증가 및 테두리 강화 */
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 rgba(160, 192, 235, 0.90), 
        stop:1 rgba(175, 205, 245, 0.95));
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.35);
}

QSlider::handle:horizontal {
    background: #A8CBF5;
    border: 1px solid rgba(255, 255, 255, 0.55);
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #FFFFFF;
    border: 1px solid #CADFF8;
}

QSlider::handle:horizontal:pressed {
    background: #BACFE8;
}

QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    width: 8px;
    margin: 4px 2px 4px 4px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(215, 228, 245, 0.32);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(215, 228, 245, 0.52);
    border-color: rgba(255, 255, 255, 0.40);
}

QScrollBar::horizontal {
    background: transparent;
    height: 0px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    height: 0px;
    width: 0px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget, 
QScrollArea > QWidget > QWidget {
    background: transparent;
}

QFrame#playlistOptionBar {
    background: rgba(22, 30, 46, 0.82);
    border: 1px solid rgba(225, 240, 255, 0.26);
    border-radius: 12px;
}

QFrame#playlistSubBar {
    background: rgba(22, 30, 46, 0.60);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
}

QListWidget {
    background: transparent;
    border: none;
    outline: none;
    padding: 0px 4px 0px 0px;
}

QListWidget::item {
    background: transparent;
    border: none;
    padding: 0px;
}

QListWidget::item:selected, 
QListWidget::item:hover {
    background: transparent;
    border: none;
}

QLabel#card_title {
    color: #D3E2F2;
    font-size: 12px;
    background: transparent;
}

QFrame#innerPlaylistCard[state="selected"] QLabel#card_title {
    color: #FFFFFF;
    font-weight: 600;
}

QFrame#right_ppanel {
    background: transparent;
    margin: 0px;
}


QPushButton#trafficBtn {
    border: none;
    border-radius: 6px;
    min-width: 5px;
    max-width: 5px;
    min-height: 5px;
    max-height: 5px;
}

QPushButton#trafficBtn:hover {
    border: 1px solid rgba(255, 255, 255, 0.55);
}


FloatingGlassPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 rgba(255, 255, 255, 0.12), 
        stop:1 rgba(110, 125, 145, 0.06));
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
}

FloatingGlassPanel#playlistContainer {
    background: transparent;
    border: none;
}

QFrame#innerPlaylistCard[state="normal"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 rgba(255, 255, 255, 0.08), 
        stop:1 rgba(120, 135, 155, 0.04));
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
}

QFrame#innerPlaylistCard[state="hover"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 rgba(255, 255, 255, 0.16), 
        stop:1 rgba(130, 150, 175, 0.07));
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
}

QFrame#innerPlaylistCard[state="selected"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 rgba(255, 255, 255, 0.22), 
        stop:1 rgba(140, 180, 230, 0.12));
    border: 1px solid rgba(255, 255, 255, 0.30);
    border-radius: 10px;
}

QFrame#topControlBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 rgba(255, 255, 255, 0.12), 
        stop:1 rgba(110, 125, 145, 0.06));
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 15px;
}