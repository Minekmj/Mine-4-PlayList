QMainWindow {
    background-color: transparent;
}

QWidget {
    color: #FFFFFF;
    font-family: 'Pretendard', 'Segoe UI', -apple-system, sans-serif;
    font-size: 12px;
    selection-background-color: rgba(140, 190, 255, 0.35);
    selection-color: #FFFFFF;
}

FloatingGlassPanel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(255, 255, 255, 0.10), 
        stop:0.04 rgba(255, 255, 255, 0.03), 
        stop:0.5 rgba(30, 42, 62, 0.08), 
        stop:1 rgba(18, 26, 40, 0.11));
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 20px;
}

FloatingGlassPanel#playlistContainer {
    background: transparent;
    border: none;
}

QFrame#topControlBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(255, 255, 255, 0.12), 
        stop:0.05 rgba(255, 255, 255, 0.03), 
        stop:1 rgba(20, 30, 48, 0.14));
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 15px;
}

QLabel {
    background: transparent;
    color: #FFFFFF;
}

#lbl_cur_time {
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
}

#lbl_cur_time {
    color: #FFFFFF;
    font-size: 11px;
}

#lbl_list {
    font-weight: 700;
    font-size: 14px;
    color: #FFFFFF;
}

#lbl_list_count {
    color: #d4d6da;
    font-size: 12px;
    font-weight: 600;
}

QToolTip {
    background-color: rgba(18, 24, 36, 0.92);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 11px;
}

QPushButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 6px 14px;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
    color: #FFFFFF;
}

QPushButton:pressed {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.10);
    color: #C0D2E8;
}

QPushButton:disabled {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.20);
}

QPushButton#btn_mode {
    font-size: 11px;
    padding: 4px 9px;
}

QPushButton#iconBtn {
    background: transparent;
    border: none;
    padding: 5px;
    border-radius: 6px;
}

QPushButton#iconBtn:hover {
    background: rgba(255, 255, 255, 0.12);
}

QPushButton#playBtn {
    background: transparent;
    border: none;
    border-radius: 20px;
}

QPushButton#playBtn:hover {
    background: rgba(255, 255, 255, 0.10);
}

QPushButton#trafficBtn {
    border: none;
    border-radius: 6px;
    min-width: 5px;
    max-width: 5px;
    min-height: 5px;
    max-height: 5px;
}

QPushButton#trafficBtn:hover {
    border: 1px solid rgba(255, 255, 255, 0.7);
}

QSlider {
    height: 20px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 rgba(253, 253, 253, 0.8), 
        stop:1 rgba(204, 204, 204, 0.85));
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #c8cfd8;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #FFFFFF;
}

QSlider::handle:horizontal:pressed {
    background: #BACFE8;
}

QFrame#playlistOptionBar {
    background: rgba(25, 35, 52, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
}

QFrame#playlistSubBar {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
}

QListWidget {
    background: transparent;
    border: none;
    outline: none;
    padding: 0px 4px 0px 0px;
}

QListWidget::item {
    background: transparent;
    border: none;
    padding: 0px;
}

QListWidget::item:selected, 
QListWidget::item:hover {
    background: transparent;
    border: none;
}

QFrame#innerPlaylistCard[state="normal"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(255, 255, 255, 0.08), 
        stop:1 rgba(25, 36, 54, 0.10));
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
}

QFrame#innerPlaylistCard[state="hover"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 rgba(255, 255, 255, 0.18), 
        stop:1 rgba(60, 90, 140, 0.20));
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 10px;
}

QFrame#innerPlaylistCard[state="selected"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 rgba(90, 165, 250, 0.28), 
        stop:1 rgba(40, 100, 200, 0.28));
    border: 1px solid rgba(190, 225, 255, 0.80);
    border-radius: 10px;
}

QLabel#card_title {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QFrame#innerPlaylistCard[state="selected"] QLabel#card_title {
    color: #FFFFFF;
    font-weight: 700;
}

QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 3px;
    margin: 4px 2px;
    border-radius: 1.5px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.20);
    border-radius: 1.5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar::horizontal,
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    height: 0px;
    width: 0px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget, 
QScrollArea > QWidget > QWidget {
    background: transparent;
}

QFrame#right_ppanel {
    background: transparent;
    margin: 0px;
}